];

let currentTab = 0;
let hoverTarget = null;
let indicatorRafId = 0;

function render() {
  const navbar = $("navbar"), content = $("content");
  if (document.querySelector(".keybind.listening")) post({ t:"cancelbind" });
  navbar.innerHTML = '<div class="navbar-indicator" id="navbarIndicator"></div>';
  content.innerHTML = "";
  hoverTarget = null;

  TABS.forEach((tab, i) => {
    const b = document.createElement("button");
    b.className = "navbar-item" + (i === currentTab ? " active" : "");
    b.innerHTML = (tab.icon || '') + '<span>' + tab.name + '</span>';
    b.addEventListener("click", () => { currentTab = i; render(); });
    b.addEventListener("mouseenter", () => { hoverTarget = b; startIndicatorLoop(); });
    b.addEventListener("mouseleave", () => { hoverTarget = null; });
    navbar.appendChild(b);
  });

  const searchWrap = document.createElement("div");
  searchWrap.className = "navbar-search";
  searchWrap.innerHTML = '<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg><input id="searchInput" type="text" placeholder="Search..." autocomplete="off" spellcheck="false">';
  navbar.appendChild(searchWrap);

  const searchInput = searchWrap.querySelector("#searchInput");
  searchInput.addEventListener("input", runSearch);
  searchInput.addEventListener("focus", () => { searchWrap.classList.add("focused"); runSearch(); });
  searchInput.addEventListener("blur", () => { searchWrap.classList.remove("focused"); });
  searchInput.addEventListener("keydown", (e) => {
    if (e.key === "Escape") { searchInput.value = ""; searchInput.blur(); $("searchDrop").classList.remove("open"); }
  });
  searchWrap.addEventListener("mouseenter", () => { hoverTarget = searchWrap; startIndicatorLoop(); });
  searchWrap.addEventListener("mouseleave", () => { hoverTarget = null; });

  startIndicatorLoop();
  updateInjectPill();

  const panel = document.createElement("div");
  panel.className = "panel active";
  const add = (g, el) => g.appendChild(el);
  TABS[currentTab].build(panel, add);
  content.appendChild(panel);
  syncDOM();
}

function startIndicatorLoop() {
  if (indicatorRafId) return;
  indicatorRafId = requestAnimationFrame(function tick() {
    const navbar = $("navbar"), indicator = $("navbarIndicator");
    if (!navbar || !indicator) { indicatorRafId = 0; return; }
    const target = hoverTarget || navbar.querySelector(".navbar-item.active");
    if (!target) { indicator.style.width = "0"; indicatorRafId = 0; return; }
    const navRect = navbar.getBoundingClientRect();
    const tRect = target.getBoundingClientRect();
    indicator.style.left = (tRect.left - navRect.left) + "px";
    indicator.style.width = tRect.width + "px";
    indicatorRafId = requestAnimationFrame(tick);
  });
}

function updateInjectPill() {
  const pill = $("injectPill");
  const label = $("injectLabel");
  if (!pill || !label) return;
  pill.className = "inject-pill" +
    (injectState === 'injecting' ? ' injecting' :
     injectState === 'attached' ? ' attached' :
     injectState === 'failed' ? ' failed' : '');
  label.textContent = injectState === 'injecting' ? 'Injecting...' :
    injectState === 'attached' ? 'Attached' :
    injectState === 'failed' ? 'Failed' : 'Inject';
}

let SEARCH_INDEX = [];
function buildSearchIndex() {
  SEARCH_INDEX = [];
  TABS.forEach((tab, ti) => {
    const tmp = document.createElement("div");
    const add = (g, el) => g.appendChild(el);
    tab.build(tmp, add);
    tmp.querySelectorAll(".group").forEach((grp) => {
      const gtitle = grp.querySelector(".group-title")?.textContent || "";
      grp.querySelectorAll(".row").forEach((r) => {
        const label = r.querySelector(".label")?.textContent || "";
        if (label) SEARCH_INDEX.push({ tab: ti, tabName: tab.name, group: gtitle, name: label });
      });
      grp.querySelectorAll(".info").forEach((i) => {
        const t = i.textContent || ""; if (t) SEARCH_INDEX.push({ tab: ti, tabName: tab.name, group: gtitle, name: t });
      });
    });
  });
}
function positionSearchDrop() {
  const inp = $("searchInput"), drop = $("searchDrop");
  if (!inp || !drop) return;
  const r = inp.getBoundingClientRect();
  drop.style.top = (r.bottom + 4) + "px"; drop.style.left = r.left + "px";
  drop.style.width = Math.max(r.width, 200) + "px";
}
function runSearch() {
  const inp = $("searchInput"), drop = $("searchDrop");
  if (!inp || !drop) return;
  const q = inp.value.trim().toLowerCase();
  drop.innerHTML = "";
  if (!q) { drop.classList.remove("open"); return; }
  positionSearchDrop();
  const hits = SEARCH_INDEX.filter(x => x.name.toLowerCase().includes(q) || x.tabName.toLowerCase().includes(q));
  if (hits.length === 0) {
    const n = document.createElement("div"); n.className = "search-none"; n.textContent = "No features found";
    drop.appendChild(n);
  } else {
    hits.slice(0, 20).forEach((h) => {
      const it = document.createElement("div"); it.className = "search-item";
      const name = document.createElement("span"); name.className = "si-name"; name.textContent = h.name;
      const meta = document.createElement("span"); meta.className = "si-tab"; meta.textContent = h.tabName + (h.group ? " · " + h.group : "");
      it.appendChild(name); it.appendChild(meta);
      it.addEventListener("click", () => { currentTab = h.tab; render(); flashFeature(h.name); inp.value = ""; drop.classList.remove("open"); });
      drop.appendChild(it);
    });
  }
  drop.classList.add("open");
}
function flashFeature(name) {
  let el = null;
  document.querySelectorAll(".content .row, .content .info").forEach((n) => {
    const t = n.querySelector(".label") ? n.querySelector(".label").textContent : n.textContent;
    if (t === name) el = n;
  });
  if (!el) return;
  el.scrollIntoView({ block: "center", behavior: "smooth" });
  el.style.transition = "background .6s ease";
  el.style.background = "rgba(255, 255, 255, 0.05)";
  setTimeout(() => { el.style.background = ""; }, 1400);
}
buildSearchIndex();
document.addEventListener("click", (e) => { if (!e.target.closest(".navbar-search")) { const drop = $("searchDrop"); if (drop) drop.classList.remove("open"); } });
window.addEventListener("resize", () => { const drop = $("searchDrop"); if (drop && drop.classList.contains("open")) positionSearchDrop(); });

function applyState(s) {
  if (!s) return;
  for (const sec in s) for (const key in s[sec]) if (sec in SETTINGS && key in SETTINGS[sec]) SETTINGS[sec][key] = s[sec][key];
  syncDOM();
}
function syncDOM() {
  document.querySelectorAll("input[type=checkbox]").forEach((inp) => {
    const v = SETTINGS[inp.dataset.sec]?.[inp.dataset.key];
    if (v !== undefined && inp.checked !== !!v) inp.checked = !!v;
  });
  document.querySelectorAll("input[type=range]").forEach((inp) => {
    const v = SETTINGS[inp.dataset.sec]?.[inp.dataset.key]; if (v === undefined) return;
    if (inp.value !== String(v)) { inp.value = v; if (inp.out) inp.out.textContent = parseFloat(v).toFixed(inp.fmt); if (inp.setFill) inp.setFill(); }
  });
  document.querySelectorAll("select").forEach((sel) => {
    const v = SETTINGS[sel.dataset.sec]?.[sel.dataset.key];
    if (v !== undefined && sel.value !== String(v)) sel.value = String(v);
  });
  document.querySelectorAll(".dd-wrap").forEach((wrap) => {
    const sec = wrap.dataset.sec, key = wrap.dataset.key;
    const v = SETTINGS[sec]?.[key]; if (v === undefined) return;
    const hidden = wrap.querySelector("select");
    if (hidden && hidden.value !== String(v)) hidden.value = String(v);
    const label = wrap.querySelector(".dd-label");
    const selected = wrap.querySelector('.dd-option[data-val="' + v + '"]');
    if (label && selected) label.textContent = selected.querySelector(".dd-option-label").textContent;
    wrap.querySelectorAll(".dd-option").forEach(x => x.classList.toggle("selected", parseInt(x.dataset.val, 10) === v));
  });
  document.querySelectorAll("input[type=color]").forEach((inp) => {
    const v = SETTINGS[inp.dataset.sec]?.[inp.dataset.key];
    if (v !== undefined && inp.value !== v) inp.value = v;
  });
  document.querySelectorAll(".keybind").forEach((btn) => {
    if (!btn.classList.contains("listening")) {
      const v = SETTINGS[btn.dataset.sec]?.[btn.dataset.key];
      if (v !== undefined && btn.textContent !== keyName(v)) btn.textContent = keyName(v);
    }
  });
  applyBgMode();
}

const statusRefs = { fps: null };
function updateStatus(m) {
  const fps = statusRefs.fps || (statusRefs.fps = $("fpsText"));
  if (fps) { const v = m.fps || "--"; if (fps.textContent !== v) fps.textContent = v; }
  const set = (id, val) => { const el = $(id); if (el) el.textContent = val; };
  set("stProcess", m.proc ? "Running" : "Not Found");
  if (m.proc) { $("stProcess").style.color = "#6ee7b7"; } else if ($("stProcess")) { $("stProcess").style.color = "#fca5a5"; }
  set("stPid", m.pid ? String(m.pid) : "--");
  set("stBase", m.base ? "0x" + m.base.toString(16).toUpperCase() : "--");
  set("stInject", m.attached ? "Attached" : "Detached");
  if (m.attached) { $("stInject").style.color = "#6ee7b7"; } else if ($("stInject")) { $("stInject").style.color = "#fca5a5"; }
  set("stAuth", m.auth ? (m.username || "Logged in") : "Not authenticated");
  if (m.auth) { $("stAuth").style.color = "#6ee7b7"; } else if ($("stAuth")) { $("stAuth").style.color = "#fca5a5"; }
  set("stFps", m.fps ? String(m.fps) : "--");
}
function onBindDone(sec, key, vk) {
  document.querySelectorAll(".keybind").forEach((b) => {
    if (b.dataset.sec === sec && b.dataset.key === key) {
      b.classList.remove("listening");
      if (vk >= 0) { SETTINGS[sec][key] = vk; b.textContent = keyName(vk); }
      else b.textContent = keyName(SETTINGS[sec][key] || 0);
    }
  });
}

let injectState = 'idle';
function requestInject() {
  if (injectState === 'injecting' || injectState === 'attached') return;
  injectState = 'injecting';
  updateInjectPill();
  post({ t: 'inject' });
}
function updateInjectStatus(m) {
  injectState = m.status || 'idle';
  updateInjectPill();
}

/* ==========================================================
   BEAMS BACKGROUND (Light Rays)
   ========================================================== */
let beamsRaf = 0;
let beamsRunning = false;
let beams = [];
const BEAM_COUNT = 24;

function initBeamsBackground() {
  const canvas = $("beamsCanvas");
  if (!canvas) return;
  const app = document.querySelector(".app");
  canvas.width = app.clientWidth;
  canvas.height = app.clientHeight;
  beams = [];
  for (let i = 0; i < BEAM_COUNT; i++) beams.push(createBeam(canvas.height, canvas.width));
}

function createBeam(h, w) {
  const fromBottom = Math.random() > 0.3;
  return {
    x: Math.random() * (w + 200) - 100,
    y: fromBottom ? h * (0.75 + Math.random() * 0.35) : Math.random() * h,
    w: 40 + Math.random() * 80,
    h: 500 + Math.random() * 500,
    angle: -0.5 + Math.random() * 1.0,
    speed: 0.15 + Math.random() * 0.35,
    opacity: 0.12 + Math.random() * 0.18,
    pulse: Math.random() * Math.PI * 2,
    pulseSpeed: 0.008 + Math.random() * 0.015
  };
}

function drawBeams() {
  const canvas = $("beamsCanvas");
  if (!canvas || !beamsRunning) return;
  const ctx = canvas.getContext("2d");
  const w = canvas.width, h = canvas.height;
  ctx.clearRect(0, 0, w, h);

  const hex = SETTINGS.ui.bgColor || "#3b82f6";
  const r = parseInt(hex.slice(1,3),16);
  const g = parseInt(hex.slice(3,5),16);
  const b = parseInt(hex.slice(5,7),16);

  ctx.filter = "blur(20px)";

  for (const beam of beams) {
    beam.y -= beam.speed;
    beam.pulse += beam.pulseSpeed;
    const pulsedOpacity = beam.opacity * (0.5 + 0.5 * Math.sin(beam.pulse));
    if (beam.y + beam.h < -100) {
      beam.y = h + 100;
      beam.x = Math.random() * (w + 200) - 100;
    }
    ctx.save();
    ctx.translate(beam.x + beam.w / 2, beam.y + beam.h / 2);
    ctx.rotate(beam.angle);
    const grad = ctx.createLinearGradient(0, -beam.h / 2, 0, beam.h / 2);
    grad.addColorStop(0, "rgba(" + r + "," + g + "," + b + ",0)");
    grad.addColorStop(0.15, "rgba(" + r + "," + g + "," + b + "," + (pulsedOpacity * 0.5) + ")");
    grad.addColorStop(0.5, "rgba(" + r + "," + g + "," + b + "," + pulsedOpacity + ")");
    grad.addColorStop(0.85, "rgba(" + r + "," + g + "," + b + "," + (pulsedOpacity * 0.5) + ")");
    grad.addColorStop(1, "rgba(" + r + "," + g + "," + b + ",0)");
    ctx.fillStyle = grad;
    ctx.fillRect(-beam.w / 2, -beam.h / 2, beam.w, beam.h);
    ctx.restore();
  }

  ctx.filter = "none";

  const glowGrad = ctx.createRadialGradient(w / 2, h + 40, 0, w / 2, h + 40, h * 0.6);
  glowGrad.addColorStop(0, "rgba(" + r + "," + g + "," + b + ",0.08)");
  glowGrad.addColorStop(0.5, "rgba(" + r + "," + g + "," + b + ",0.03)");
  glowGrad.addColorStop(1, "rgba(" + r + "," + g + "," + b + ",0)");
  ctx.fillStyle = glowGrad;
  ctx.fillRect(0, 0, w, h);

  beamsRaf = requestAnimationFrame(drawBeams);
}

function startBeams() {
  if (beamsRaf) { cancelAnimationFrame(beamsRaf); beamsRaf = 0; }
  const canvas = $("beamsCanvas");
  if (!canvas) return;
  beamsRunning = true;
  canvas.style.display = "block";
  if (!beams.length) initBeamsBackground();
  beamsRaf = requestAnimationFrame(drawBeams);
}

function stopBeams() {
  beamsRunning = false;
  if (beamsRaf) { cancelAnimationFrame(beamsRaf); beamsRaf = 0; }
  const canvas = $("beamsCanvas");
  if (canvas) canvas.style.display = "none";
}

function updateCanvasSize() {
  const canvas = $("beamsCanvas");
  if (!canvas) return;
  const app = document.querySelector(".app");
  canvas.width = app.clientWidth;
  canvas.height = app.clientHeight;
}

function applyBgMode() {
  const mode = SETTINGS.ui.bgMode;
  const app = document.querySelector(".app");
  if (mode === 1) {
    if (app) app.classList.add("rays-mode");
    startBeams();
  } else {
    if (app) app.classList.remove("rays-mode");
    stopBeams();
  }
}

window.addEventListener("resize", () => {
  updateCanvasSize();
  if (SETTINGS.ui.bgMode === 1) { const was = beamsRunning; initBeamsBackground(); if (was) startBeams(); }
});

render(); post({ t:"ready" });

/* ==========================================================
   ONBOARDING TUTORIAL SYSTEM
   ========================================================== */
let tutorialCurrentStep = 0;
const tutorialSteps = [
  {
    selector: ".navbar",
    text: "This is the main navigation bar. Use it to switch between feature tabs.",
    action: () => {}
  },
  {
    selector: ".navbar-search",
    text: "Quick search bar. Type a feature name to find it instantly.",
    action: () => {}
  },
  {
    selector: ".inject-pill",
    text: "Click here to inject into the Roblox process. Wait for 'Attached' status.",
    action: () => {}
  },
  {
    selector: "#navbar .navbar-item:nth-child(4)",
    text: "Let's check the Info tab to see credits and community links.",
    action: () => {
      document.querySelectorAll('.navbar-item')[3]?.click();
    }
  },
  {
    selector: "#content .group:nth-of-type(2)",
    text: "Join our Discord server for updates, support, and new features!",
    action: () => {}
  }
];

function showReadyModal() {
  const modal = $("readyModal");
  if (!modal) return;
  modal.classList.add("active");
  $("readySkip").onclick = () => { modal.classList.remove("active"); endTutorial(); };
  $("readyStart").onclick = () => { modal.classList.remove("active"); startTutorial(); };
}

function startTutorial() {
  tutorialCurrentStep = 0;
  const overlay = $("tutorialOverlay");
  overlay.classList.add("active");
  renderTutorialStep();
}

function renderTutorialStep() {
  const overlay = $("tutorialOverlay");
  const spotlight = $("tutorialSpotlight");
  const tooltip = $("tutorialTooltip");
  if (tutorialCurrentStep >= tutorialSteps.length) { endTutorial(); return; }

  const step = tutorialSteps[tutorialCurrentStep];
  const el = document.querySelector(step.selector);
  if (!el) { tutorialCurrentStep++; renderTutorialStep(); return; }

  step.action();

  setTimeout(() => {
    const r = el.getBoundingClientRect();
    const pad = 6;
    spotlight.style.top = (r.top - pad) + "px";
    spotlight.style.left = (r.left - pad) + "px";
    spotlight.style.width = (r.width + pad * 2) + "px";
    spotlight.style.height = (r.height + pad * 2) + "px";

    $("ttStep").textContent = "Step " + (tutorialCurrentStep + 1) + " of " + tutorialSteps.length;
    $("ttText").textContent = step.text;

    tooltip.classList.remove("visible");
    requestAnimationFrame(() => {
      const ttRect = tooltip.getBoundingClientRect();
      let top = r.top - ttRect.height - 14;
      let left = r.left + r.width / 2 - ttRect.width / 2;
      if (top < 8) top = r.bottom + 14;
      if (left < 8) left = 8;
      if (left + ttRect.width > window.innerWidth - 8) left = window.innerWidth - ttRect.width - 8;
      tooltip.style.top = top + "px";
      tooltip.style.left = left + "px";
      tooltip.classList.add("visible");
    });

    $("ttNext").textContent = tutorialCurrentStep === tutorialSteps.length - 1 ? "Finish" : "Next";
    $("ttSkip").onclick = endTutorial;
    $("ttNext").onclick = () => {
      tutorialCurrentStep++;
      if (tutorialCurrentStep < tutorialSteps.length) renderTutorialStep();
      else endTutorial();
    };
  }, 80);
}

function endTutorial() {
  const overlay = $("tutorialOverlay");
  const tooltip = $("tutorialTooltip");
  overlay.classList.remove("active");
  tooltip.classList.remove("visible");
  showWelcomeFinal();
}

function showWelcomeFinal() {
  const screen = $("welcomeFinalScreen");
  if (!screen) return;
  screen.classList.add("active");
  setTimeout(() => { screen.classList.add("fade-out"); }, 3500);
  setTimeout(() => { screen.classList.remove("active", "fade-out"); screen.style.display = "none"; }, 4200);
}
</script>
</body>
</html>
